{
  "browser": {
    "command": "uv",
    "args": [
      "run",
      "server_browser.py"
    ],
    "type": "local-script",
    "enabled": true
  },
  "rag": {
    "command": "uv",
    "args": [
      "run",
      "server_rag.py"
    ],
    "type": "local-script",
    "enabled": true
  },
  "sandbox": {
    "command": "uv",
    "args": [
      "run",
      "server_sandbox.py"
    ],
    "type": "local-script",
    "enabled": true
  },
  "yahoo_finance": {
    "type": "stdio-git",
    "source": "https://github.com/dino65-dev/Finance_mcp-server",
    "command": "uv",
    "args": [
      "run",
      "yfinance_mcp_server.py"
    ],
    "enabled": true
  },
  "mockehr": {
    "command": "uv",
    "args": [
      "run",
      "server_mockehr.py"
    ],
    "type": "local-script",
    "enabled": true
  },
  "gbrain": {
    "command": "bun",
    "args": [
      "run",
      "src/cli.ts",
      "serve"
    ],
    "cwd": "gbrain",
    "type": "local-command",
    "enabled": true
  }
}

# gemma4:e4b needs ~6.7+ GiB; use local-laptop-gemma-docker (~4B) on 8GB Docker hosts.
# For gemma4, set S18_PROFILE=local-laptop-gemma and give Docker Desktop 10+ GiB RAM.
S18_PROFILE=local-laptop-gemma-docker
S18_AUTH_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_TIMEOUT=360
# One loaded model at a time — helps on 8GB Docker/WSL hosts running gemma4:e4b + nomic-embed-text.
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
LLAMA_CPP_BASE_URL=http://llama_cpp:8080
LLAMA_CPP_TIMEOUT=360
S18_RUN_EXECUTOR=in_process
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
S18_CELERY_PREFETCH_MULTIPLIER=1

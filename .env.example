GEMINI_API_KEY=
# If using compose ollama service, keep this default.
# If using host Ollama, set to http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434
# Ollama HTTP timeout (seconds). Affects run completion; allow 360+ for slow agent steps.
OLLAMA_TIMEOUT=360
# Optional: store the Ollama container's model data on a specific drive (Windows example).
# Create the folder first, use forward slashes. Leave unset to use Docker's named volume.
# OLLAMA_HOST_DATA=D:/docker/ollama

# Supabase auth + backend verification
AUTH_ENABLED=false
# Docker compose uses this to avoid collisions with other repos' AUTH_ENABLED.
S18_AUTH_ENABLED=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_AUDIENCE=authenticated

# Optional backend persistence to Supabase tables
SUPABASE_LOGGING_ENABLED=false
SUPABASE_SERVICE_ROLE_KEY=

# EHR Data Miner (mockehr) – wise-ai integration
# Base URL of wise-ai Mock EHR API. When set, mockehr fetches /patients/{id} and /patients/{id}/labs from wise-ai.
# Example: http://backend:8000 (Docker) or http://localhost:8000 (host)
WISE_MOCKEHR_BASE_URL=

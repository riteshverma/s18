GEMINI_API_KEY=
# Azure OpenAI (Phase 1: chat + embeddings)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# If using compose ollama service, keep this default.
# If using host Ollama, set to http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434
# Ollama HTTP timeout (seconds). Affects run completion; allow 360+ for slow agent steps.
OLLAMA_TIMEOUT=360

# Supabase auth + backend verification
AUTH_ENABLED=false
# Docker compose uses this to avoid collisions with other repos' AUTH_ENABLED.
S18_AUTH_ENABLED=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_AUDIENCE=authenticated

# Optional backend persistence to Supabase tables
SUPABASE_LOGGING_ENABLED=false
SUPABASE_SERVICE_ROLE_KEY=

# EHR Data Miner (mockehr) – wise-ai integration
# Base URL of wise-ai Mock EHR API. When set, mockehr fetches /patients/{id} and /patients/{id}/labs from wise-ai.
# Examples: http://backend:8000 (Docker), http://localhost:8000 (host), https://your-wise-ai.up.railway.app (Railway)
WISE_MOCKEHR_BASE_URL=

# Browser CORS: comma-separated origins for production frontends calling S18 directly (e.g. wise-ai web).
# CORS_ALLOWED_ORIGINS=https://your-wise-ai.up.railway.app
# Optional: override regex (set empty to disable). Default allows localhost dev ports.
# CORS_ALLOW_ORIGIN_REGEX=
